# ============================================================================
# AI OLLY — Environment variable contract (EXAMPLE — no real values)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in locally. `.env` is gitignored — NEVER commit real
# secrets. Real values also live in the Render dashboard (server) per environment.
#
# Phase 1 note: the app STILL RUNS ON AIRTABLE. Supabase variables are optional
# and only used by the isolated connection test until later phases wire them in.
# ============================================================================

# ── Existing v1 backend (unchanged) ─────────────────────────────────────────
# (names only — see the running production for the actual set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBHOOK_SECRET=
RECEPTION_PIN=
BREVO_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_FROM_NAME=
# CATHEDRA_AIRTABLE_BASE_ID=
# CATHEDRA_AIRTABLE_API_KEY=

# ── Data provider switch (Phase 1 foundation) ───────────────────────────────
# Controls which backend the DATA LAYER uses. Default MUST remain "airtable".
# "supabase" and compare mode are introduced endpoint-by-endpoint in later phases.
DATA_PROVIDER=airtable
DATA_PROVIDER_COMPARE=false

# ── Supabase — SERVER-ONLY secrets (Render / local .env; NEVER in the browser) ─
# The guest PWA does NOT receive these in this phase.
SUPABASE_URL=                     # e.g. https://<project-ref>.supabase.co  (technically public, but grouped with server config here)
SUPABASE_SERVICE_ROLE_KEY=        # SECRET — bypasses RLS. Server-only. Never ship to any browser bundle.
SUPABASE_DB_URL=                  # SECRET — Postgres/pooler connection string (used by CLI/migrations/tools)
SUPABASE_DB_PASSWORD=             # SECRET — database password

# ── Supabase — PUBLIC values (safe for a future browser DASHBOARD only) ──────
# These belong to the future Next.js dashboard build, NOT the guest PWA.
# Kept here for documentation; they are public by design but access is still
# restricted by Row-Level Security (RLS).
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
